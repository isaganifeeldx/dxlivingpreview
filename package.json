{
  "name": "dxliving-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/ensure-db-schema.ts && next build",
    "start": "next start",
    "lint": "next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "db:ensure": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/ensure-db-schema.ts",
    "db:push": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/ensure-db-schema.ts",
    "seed:home": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-home.ts",
    "seed:settings": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-settings.ts",
    "seed:about": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-about.ts",
    "seed:modules": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-modules.ts",
    "seed:studio": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-studio.ts",
    "seed:privacy": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-privacy.ts",
    "seed:terms": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-terms.ts",
    "seed:faq": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-faq.ts",
    "seed:not-found": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-not-found.ts",
    "seed:interiors": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-interiors.ts",
    "seed:model": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-model.ts",
    "seed:prestige": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-prestige.ts",
    "seed:suppliers": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-suppliers.ts",
    "seed:apply": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-apply.ts",
    "seed:contact": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-contact.ts",
    "seed:articles-page": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-articles-page.ts",
    "seed:article-categories": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-article-categories.ts",
    "seed:articles": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-articles.ts",
    "seed:projects-page": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-projects-page.ts",
    "seed:projects": "node --require ./scripts/patch-next-env.cjs --import tsx scripts/seed-projects.ts",
    "sync:wp-seed": "node --import tsx scripts/sync-wp-seed-data.ts",
    "importmap": "node --require ./scripts/patch-next-env.cjs --import tsx ./node_modules/payload/bin.js generate:importmap"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@next/env": "^16.3.0",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-s3": "3.86.0",
    "@payloadcms/storage-vercel-blob": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "graphql": "^16.14.2",
    "gsap": "^3.13.0",
    "isomorphic-dompurify": "^3.19.0",
    "lottie-web": "^5.13.0",
    "next": "15.3.9",
    "payload": "3.86.0",
    "pg": "^8.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.8",
    "typescript": "^5"
  },
  "overrides": {
    "jsdom": "25.0.1"
  }
}
