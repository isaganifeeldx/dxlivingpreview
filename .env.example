NEXT_PUBLIC_SITE_URL=http://localhost:3000
# On Vercel, leave unset for first deploy — the app uses VERCEL_URL /
# VERCEL_PROJECT_PRODUCTION_URL automatically. Set this when you add a custom domain.
# On EC2 / custom domain: REQUIRED — public https URL, no trailing slash
# (e.g. https://dxliving.com). Wrong/missing value can break /admin cookies.

# Optional: Claude-powered chat replies for the Support FAB.
# Without this key, the chatbot still works using built-in FAQ matching.
# ANTHROPIC_API_KEY=

# Only dxliving.com is crawlable by default. Set to 1 to preview sitemap/robots locally,
# or 0 to force noindex even on production host.
# NEXT_PUBLIC_ALLOW_SEARCH_INDEXING=1

# Payload CMS
# Works with local Postgres, Neon, RDS, or EC2-hosted Postgres — same variable name.
# RDS example:
# DATABASE_URI=postgresql://USER:PASS@your-rds.region.rds.amazonaws.com:5432/dxliving_cms?sslmode=require
DATABASE_URI=postgresql://payload:payload@localhost:5432/dxliving_cms
PAYLOAD_SECRET=replace-with-long-random-string

# -----------------------------------------------------------------------------
# Media storage (pick one path)
# -----------------------------------------------------------------------------
#
# Local / single-node without object storage:
#   Leave Blob + S3 unset → files save under ./media on the app disk
#   (ok for local only — not for multi-instance / replaceable EC2).
#
# Vercel:
#   Optional for first deploy (site/admin work without it).
#   When you need CMS media uploads: Storage → Blob, link Production + Preview.
#   Vercel injects BLOB_READ_WRITE_TOKEN after the store is connected; redeploy.
#   Token looks like: vercel_blob_rw_...
BLOB_READ_WRITE_TOKEN=
#
# EC2 / AWS production (Postgres + S3) — set these:
#   S3_BUCKET, S3_REGION
#   Prefer an EC2 instance IAM role with s3:GetObject / PutObject / DeleteObject
#   (and ListBucket if needed) on the media bucket — then omit access keys.
#   Keys are optional fallbacks only (dev / no instance role).
S3_BUCKET=
S3_REGION=ap-southeast-2
# Optional explicit keys (skip when using an instance role).
# Aliases also accepted: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional CloudFront or custom public base (no trailing slash):
# S3_PUBLIC_URL=https://d111111abcdef8.cloudfront.net
# Object ACL. Default public-read. Use "none" if the bucket has ACLs disabled
# (Bucket owner enforced) and public read is via bucket policy / CloudFront OAC.
# S3_ACL=public-read
# MinIO / path-style / custom endpoint (optional):
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
#
# Selection rules (see src/lib/cms/mediaStorage.ts):
#   1. Valid BLOB_READ_WRITE_TOKEN → Vercel Blob
#   2. Else if S3_BUCKET is set → S3
#   3. Else → local disk
#
# EC2 WARNING: leave BLOB_READ_WRITE_TOKEN empty on EC2.
# If the Blob token is set, media goes to Vercel Blob instead of S3.
#
# Important: if DATABASE_URI points at Neon/Vercel and you seed from your laptop,
# set BLOB_READ_WRITE_TOKEN (or S3_BUCKET). Otherwise Media rows are remote but
# files stay on your machine — admin thumbnails break and deletes 404.

# Schema sync (develop/staging):
# - `npm run build` / `npm run db:push` always verify DATABASE_URI is reachable
#   (local, EC2, and Vercel) — connection failure fails the build
# - Local / EC2: schema push runs by default
# - Vercel: skips schema *push* by default (avoids US↔Neon timeouts)
# - PAYLOAD_REQUIRE_SCHEMA_PUSH=true — force schema sync during Vercel builds
# - PAYLOAD_SKIP_SCHEMA_PUSH=true — skip schema push (connection check still runs)
#
# CMS content during Vercel `next build`:
# - Skipped by default (pages use code fallbacks; ISR/runtime refreshes from DB)
# - PAYLOAD_FETCH_AT_BUILD=true — force CMS reads during Vercel builds
#
# Neon URI tip (runtime): use the pooler host + sslmode=require, e.g.
# postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional: append &uselibpqcompat=true if you see pg SSL mode warnings.
# Do NOT keep channel_binding=require — Node pg on Vercel fails with it (admin white page).
# If the password contains # ? @ etc., percent-encode them (# → %23) or the build
# fails with TypeError: Invalid URL / input: '[REDACTED]' during page data collection.

# =============================================================================
# EC2 + Postgres (RDS) + S3 media — handoff checklist for AWS
# =============================================================================
# Runtime: Node.js 20.9+ (LTS). App listens on PORT (default 3000); put Nginx/ALB
# in front with HTTPS. Increase proxy body size for CMS uploads (e.g. 50m+).
#
# Required env on the instance / SSM / secrets:
#   DATABASE_URI          Postgres/RDS connection string (?sslmode=require)
#   PAYLOAD_SECRET        long random string
#   NEXT_PUBLIC_SITE_URL  public https origin, no trailing slash
#   S3_BUCKET             media bucket name
#   S3_REGION             e.g. ap-southeast-2
#
# Recommended:
#   IAM instance profile for S3 (no static keys on the box)
#   S3_PUBLIC_URL         CloudFront URL if using CDN
#   S3_ACL=none           when bucket ACLs are disabled / OAC
#
# Do NOT set on EC2:
#   BLOB_READ_WRITE_TOKEN (forces Vercel Blob over S3)
#   VERCEL=1
#
# Steps:
# 1. Empty Postgres/RDS → set DATABASE_URI (TLS: ?sslmode=require)
# 2. Security groups: app → RDS:5432; app → S3 (gateway/endpoint or NAT);
#    users → ALB/Nginx :443 → app :3000
# 3. Create S3 bucket; attach IAM role OR set S3_ACCESS_KEY_* / AWS_*
# 4. Allow media to be read publicly (bucket policy) OR via CloudFront OAC
#    so next/image can load URLs
# 5. On the server (from the app root):
#      npm ci
#      npm run db:push
#      npm run build
#      npm start
#    (use PM2/systemd to keep the process up)
# 6. Confirm /admin loads and a test Media upload appears in the S3 bucket
#
# Optional schema flags (usually leave unset on EC2):
#   PAYLOAD_SKIP_SCHEMA_PUSH / PAYLOAD_REQUIRE_SCHEMA_PUSH

# Vercel tip: for a custom domain, set NEXT_PUBLIC_SITE_URL to that URL
# (https, no trailing slash). First deploy can omit it — VERCEL_URL is used.
# If NEXT_PUBLIC_SITE_URL is set wrong, /admin can show a white page / "Connection closed".
#
# Region tip: Neon Ohio (us-east-2) needs Vercel functions in US East (iad1).
# This repo sets `"regions": ["iad1"]` in vercel.json. If functions run in sin1
# (Singapore), /admin will 504 GATEWAY_TIMEOUT.
#
# If /admin is blank after deploy:
# 1. Confirm DATABASE_URI + PAYLOAD_SECRET are set for that Vercel environment
# 2. Run `npm run db:push` locally against Neon once (creates Payload tables)
# 3. Optional: connect Vercel Blob when you need media uploads
# 4. Open browser DevTools → Console on /admin/login for import-map errors
# 5. If using a custom domain, set NEXT_PUBLIC_SITE_URL to that exact URL
#
# If `npm run build` fails with "timeout exceeded when trying to connect":
# - Ensure latest code skips CMS at Vercel build (default)
# - Neon project may be asleep — open the Neon dashboard to wake it
# - Confirm DATABASE_URI host/password are correct for Production vs Preview
