NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Claude-powered chat replies for the Support FAB.
# Without this key, the chatbot still works using built-in FAQ matching.
# ANTHROPIC_API_KEY=

# Only dxliving.com is crawlable by default. Set to 1 to preview sitemap/robots locally,
# or 0 to force noindex even on production host.
# NEXT_PUBLIC_ALLOW_SEARCH_INDEXING=1

# Payload CMS
# Works with local Postgres, Neon, RDS, or EC2-hosted Postgres — same variable name.
DATABASE_URI=postgresql://payload:payload@localhost:5432/dxliving_cms
PAYLOAD_SECRET=replace-with-long-random-string

# -----------------------------------------------------------------------------
# Media storage (pick one path)
# -----------------------------------------------------------------------------
#
# Local / single-node EC2 without object storage:
#   Leave Blob + S3 unset → files save under the app disk (ok for local only).
#
# Vercel:
#   Create a Blob store (Storage → Blob) and link Production + Preview.
#   Token looks like: vercel_blob_rw_...
BLOB_READ_WRITE_TOKEN=
#
# EC2 / AWS (recommended for production on EC2):
#   Prefer an EC2 instance IAM role with s3:GetObject/PutObject/DeleteObject
#   on the bucket — then omit access keys. Keys are optional fallbacks.
S3_BUCKET=
S3_REGION=ap-southeast-2
# Optional explicit keys (skip when using an instance role):
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional CloudFront or custom public base (no trailing slash):
# S3_PUBLIC_URL=https://d111111abcdef8.cloudfront.net
# Object ACL. Default public-read. Use "none" if the bucket has ACLs disabled
# (Bucket owner enforced) and public read is via bucket policy / CloudFront.
# S3_ACL=public-read
# MinIO / path-style / custom endpoint (optional):
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
#
# Selection rules (see src/lib/cms/mediaStorage.ts):
#   1. Vercel + valid BLOB_READ_WRITE_TOKEN → Vercel Blob
#   2. Else if S3_BUCKET is set → S3
#   3. Else → local disk

# Schema sync (develop/staging):
# - `npm run build` / `npm run db:push` always verify DATABASE_URI is reachable
#   (local, EC2, and Vercel) — connection failure fails the build
# - Local / EC2: schema push runs by default
# - Vercel: skips schema *push* by default (avoids US↔Neon timeouts)
# - PAYLOAD_REQUIRE_SCHEMA_PUSH=true — force schema sync during Vercel builds
# - PAYLOAD_SKIP_SCHEMA_PUSH=true — skip schema push (connection check still runs)
#
# CMS content during Vercel `next build`:
# - Skipped by default (pages use code fallbacks; ISR/runtime refreshes from DB)
# - PAYLOAD_FETCH_AT_BUILD=true — force CMS reads during Vercel builds
#
# Neon URI tip (runtime): use the pooler host + sslmode=require, e.g.
# postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional: append &uselibpqcompat=true if you see pg SSL mode warnings.
# Do NOT keep channel_binding=require — Node pg on Vercel fails with it (admin white page).

# EC2 + Postgres + S3 checklist:
# 1. Empty Postgres → set DATABASE_URI (add ?sslmode=require for RDS TLS)
# 2. On the server: npm ci && npm run db:push && npm run build && npm start
# 3. Set NEXT_PUBLIC_SITE_URL to the public https URL (no trailing slash)
# 4. Set PAYLOAD_SECRET
# 5. Create S3 bucket; attach IAM role to the instance OR set S3_ACCESS_KEY_*
# 6. Allow public read (bucket policy or CloudFront) so next/image can load URLs
# 7. If using CloudFront, set S3_PUBLIC_URL and S3_ACL=none when ACLs are off
# 8. Security group: app → Postgres; app → S3 (or NAT); HTTPS to the app

# Vercel tip: NEXT_PUBLIC_SITE_URL must match the URL you open in the browser
# (https, no trailing slash), e.g. https://your-project.vercel.app
# If this is wrong, /admin shows a white page / "Connection closed" in the console.
#
# Region tip: Neon Ohio (us-east-2) needs Vercel functions in US East (iad1).
# This repo sets `"regions": ["iad1"]` in vercel.json. If functions run in sin1
# (Singapore), /admin will 504 GATEWAY_TIMEOUT.
#
# If /admin is blank after deploy:
# 1. Confirm DATABASE_URI + PAYLOAD_SECRET are set for that Vercel environment
# 2. Run `npm run db:push` locally against Neon once (creates Payload tables)
# 3. Connect Vercel Blob + BLOB_READ_WRITE_TOKEN (Production + Preview)
# 4. Open browser DevTools → Console on /admin/login for import-map errors
# 5. NEXT_PUBLIC_SITE_URL should match the URL you open (https, no trailing slash)
#
# If `npm run build` fails with "timeout exceeded when trying to connect":
# - Ensure latest code skips CMS at Vercel build (default)
# - Neon project may be asleep — open the Neon dashboard to wake it
# - Confirm DATABASE_URI host/password are correct for Production vs Preview
